# Images live in three tracked folders: icons/ (what the plugin loads),
# docs/images/ (README and gallery screenshots) and docs/art/ (original
# 1024 px icon artwork). Any other image is a local by-product and stays out.
*.jpg
*.png
!icons/*.png
!docs/images/*.png
!docs/art/*.png
!docs/art/*.jpg
temp_*/

# Local private references (must never be committed)
hidden/
hidden/**

# QGIS writes its style database into the working directory when run headless
symbology-style.db

# plugin archives built by scripts/build_plugin_zip.py
dist/
